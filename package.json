{
  "name": "n8n-automatization",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted n8n (via npm) + Claude to manage Google Calendar — a learning project.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env node_modules/n8n/bin/n8n start",
    "export": "node --env-file=.env node_modules/n8n/bin/n8n export:workflow --backup --output=workflows/",
    "import": "node --env-file=.env node_modules/n8n/bin/n8n import:workflow --separate --input=workflows/",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-n8n.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-n8n.ps1",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "bridge": "node --env-file=.env scripts/claude-bridge.mjs",
    "link": "node scripts/link-credentials.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\""
  },
  "dependencies": {
    "n8n": "2.47.4"
  }
}
