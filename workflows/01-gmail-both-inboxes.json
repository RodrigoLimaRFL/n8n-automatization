      },
      "id": "6f361c7d-41e9-4500-816f-b787d47f8fb2",
      "name": "Process batches (02)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2540,
        -60
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// A batch that failed (bad email, timeout...) is retried as single emails,\n// so one bad email can't block the other seven.\nconst batches = $('Make batches').all();\nconst singles = [];\nfor (const item of $input.all()) {\n  const p = Array.isArray(item.pairedItem) ? item.pairedItem[0] : item.pairedItem;\n  const batch = batches[p && p.item];\n  if (!batch) continue;\n  for (const email of batch.json.emails) singles.push({ json: { emails: [email] } });\n}\nreturn singles;"
      },
