    {
      "parameters": {
        "jsCode": "// Groups the emails (oldest first) into batches of 8: one Claude call per batch.\nconst SIZE = 8;\nconst emails = $input.all().map((i) => i.json);\nconst batches = [];\nfor (let i = 0; i < emails.length; i += SIZE) {\n  batches.push({ json: { emails: emails.slice(i, i + SIZE).map((e) => ({ id: e.id, account: e.account, sender: e.sender, subject: e.subject, receivedAt: e.receivedAt })) } });\n}\nreturn batches;"
      },
      "id": "74900075-0176-4e92-bc88-a902645321e9",
      "name": "Make batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        -60
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "emailToTasks0002",
          "cachedResultName": "02 · Email → tasks (Claude)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
