# Copy to .env and fill in. .env is gitignored.
#
# Key n8n uses to encrypt saved credentials (OAuth tokens, API keys) in its database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it forever: if it changes, every saved credential becomes unreadable.
N8N_ENCRYPTION_KEY=

# Timezone used by Schedule triggers and date expressions.
GENERIC_TIMEZONE=America/Sao_Paulo

# Keep n8n data inside this project at ./.n8n instead of ~/.n8n
N8N_USER_FOLDER=.

# Claude bridge (scripts/claude-bridge.mjs): runs the Claude Code CLI with your Claude plan
CLAUDE_BRIDGE_PORT=5681
# Full path to claude.exe if it isn't on PATH
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: long-lived login token from `claude setup-token` (recommended for unattended runs)
# CLAUDE_CODE_OAUTH_TOKEN=
